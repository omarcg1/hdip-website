{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 build.py --out dist",
  "outputDirectory": "dist",
  "functions": {
    "api/admin.py": {
      "maxDuration": 60,
      "excludeFiles": "{dist/**,.git/**,tools/legacy/**,*.html,ar/**,assets/img/*.jpg,assets/img/*.webp,assets/img/*.png}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/(.*)", "destination": "/api/admin" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
